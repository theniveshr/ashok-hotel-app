# ─── API / Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────
# Local PostgreSQL — replace with your credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/ashok_raj_db?schema=public"

# ─── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# ─── Authentication ───────────────────────────────────────
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_USE_ANOTHER_LONG_RANDOM_STRING"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8081"

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase Cloud Messaging ─────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Sentry ───────────────────────────────────────────────
SENTRY_DSN=

# ─── mapcn.dev ────────────────────────────────────────────
MAPCN_API_KEY=

# ─── Admin (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXTAUTH_SECRET="CHANGE_ME_IN_PRODUCTION"
NEXTAUTH_URL="http://localhost:3000"


