# ─── API / Server ────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────
# Supabase Cloud PostgreSQL Connection String (Shared Pooler - Session Mode port 5432)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.grzlzvidmccrjpqxpbcf:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase Cloud API ────────────────────────────────────
SUPABASE_URL="https://grzlzvidmccrjpqxpbcf.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_LqvKiqZbZ8JIulChcktqug_aQVtzVvb"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME_KEEP_SECRET_ON_SERVER_ONLY"
NEXT_PUBLIC_SUPABASE_URL="https://grzlzvidmccrjpqxpbcf.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_LqvKiqZbZ8JIulChcktqug_aQVtzVvb"

