{
  "extends": "../../node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@ashok-raj/types": [
        "../../packages/types/src/index.ts"
      ],
      "@ashok-raj/validation": [
        "../../packages/validation/src/index.ts"
      ],
      "@ashok-raj/config": [
        "../../packages/config/src/index.ts"
      ],
      "@ashok-raj/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "App.tsx",
    "index.ts",
    "config/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "store/**/*.ts",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "i18n/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "../../node_modules/**",
    ".expo",
    ".turbo",
    "android",
    "ios"
  ]
}
