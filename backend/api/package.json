    "@ashok-raj/types": "*",
    "@ashok-raj/validation": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.3",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.3.1",
    "@sentry/node": "^8.47.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.6",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
